<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.lci.edms</groupId>
  <artifactId>scanner-desktop-client</artifactId>
  <version>0.1.0</version>
  <name>Scanner Desktop Client</name>
  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <spring.boot.version>2.5.6</spring.boot.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <version>${spring.boot.version}</version>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.22</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.itextpdf</groupId>
      <artifactId>itextpdf</artifactId>
      <version>5.5.10</version>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>jacob</id>
      <activation>
        <file>
          <exists>lib/jacob.jar</exists>
        </file>
      </activation>
      <dependencies>
        <dependency>
          <groupId>net.sf.jacob-project</groupId>
          <artifactId>jacob</artifactId>
          <version>1.21</version>
          <scope>system</scope>
          <systemPath>${project.basedir}/lib/jacob.jar</systemPath>
        </dependency>
      </dependencies>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring.boot.version}</version>
        <configuration>
          <mainClass>com.lci.scannerdesktop.ScannerDesktopApplication</mainClass>
          <!-- Include system-scoped dependencies only if they exist -->
          <includeSystemScope>true</includeSystemScope>
        </configuration>
      </plugin>
    </plugins>
    <finalName>scanner-desktop-client</finalName>
  </build>
</project>

